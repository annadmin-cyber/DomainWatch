# DomainWatch environment variables
# Copy to .env.local for local development. Never commit real values.
# In production, enter these in Vercel > Project > Settings > Environment Variables.

# REQUIRED · public (safe to expose) · Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED · public (safe to expose; RLS protects the data) · Supabase > Project Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED · SECRET (server only, bypasses RLS) · Supabase > Project Settings > API Keys > Secret keys
# (the legacy "service_role" key also works)
SUPABASE_SECRET_KEY=

# REQUIRED · SECRET · a random string of at least 16 characters that you create yourself.
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# OPTIONAL · SECRET · Telegram bot token from @BotFather. Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=

# OPTIONAL · public · base URL used for continuation runs, e.g. https://domainwatch.vercel.app
# Defaults to Vercel's VERCEL_PROJECT_PRODUCTION_URL, so you normally leave it empty.
APP_URL=
